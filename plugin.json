{
  "id": "moai",
  "name": "moai",
  "description": "agents 플러그인의 moai 메이커 group과 moai SPEC 목록 화면을 제공한다.",
  "mark": "moai",
  "icon": "<circle cx=\"8\" cy=\"8\" r=\"5.5\"/><path d=\"M5 8h6M8 5v6\"/>",
  "surface": {
    "composition": {
      "kind": "view",
      "page": "ui/specs.html"
    }
  },
  "programs": {
    "config-load": {
      "program": "moai",
      "args": ["doctor", "config", "dump", "--format", "json"]
    },
    "spec-audit": {
      "program": "moai",
      "args": ["spec", "audit", "--json", "--base-dir", "."]
    }
  },
  "dependencies": {
    "agents": "^0.0.1",
    "@soksak/sidecar-files": ">=0.0.12"
  },
  "contributes": {
    "agents.makers": [
      {
        "id": "moai",
        "name": "moai",
        "range": "^0.0.1",
        "module": "ui/makers/moai.js"
      }
    ]
  }
}
