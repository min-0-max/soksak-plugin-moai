diff --git a/internal/hook/session_end_config_dir_test.go b/internal/hook/session_end_config_dir_test.go
new file mode 100644
index 0000000..0c5e48e
--- /dev/null
+++ b/internal/hook/session_end_config_dir_test.go
@@ -0,0 +1,31 @@
+package hook
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+// The cleanup at the end of a session reads the teams and the tasks of the
+// configuration home of that session: with CLAUDE_CONFIG_DIR set, a task folder
+// of ~/.claude is kept and an orphaned task folder of the configuration home is
+// removed.
+func TestGarbageCollectOrphanedTasksUsesClaudeConfigDir(t *testing.T) {
+	home := t.TempDir()
+	config := t.TempDir()
+	t.Setenv("CLAUDE_CONFIG_DIR", config)
+	personTask := filepath.Join(home, ".claude", "tasks", "person-session")
+	orphan := filepath.Join(config, "tasks", "orphan-session")
+	for _, dir := range []string{personTask, orphan, filepath.Join(home, ".claude", "teams"), filepath.Join(config, "teams")} {
+		if err := os.MkdirAll(dir, 0o755); err != nil {
+			t.Fatal(err)
+		}
+	}
+	garbageCollectOrphanedTasks(home)
+	if _, err := os.Stat(personTask); err != nil {
+		t.Fatalf("the task folder of ~/.claude was removed: %v", err)
+	}
+	if _, err := os.Stat(orphan); !os.IsNotExist(err) {
+		t.Fatalf("the orphaned task folder of CLAUDE_CONFIG_DIR remains: %v", err)
+	}
+}
