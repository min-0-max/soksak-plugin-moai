diff --git a/internal/paths/claude_dir_test.go b/internal/paths/claude_dir_test.go
new file mode 100644
index 0000000..4b8e3af
--- /dev/null
+++ b/internal/paths/claude_dir_test.go
@@ -0,0 +1,29 @@
+package paths
+
+import (
+	"path/filepath"
+	"testing"
+)
+
+// ClaudeDir follows CLAUDE_CONFIG_DIR, which Claude Code reads as its
+// configuration home, so a session started with its own configuration home
+// never reads or removes the data of ~/.claude.
+func TestClaudeDirFollowsClaudeConfigDir(t *testing.T) {
+	home := t.TempDir()
+	config := t.TempDir()
+	t.Setenv("CLAUDE_CONFIG_DIR", config)
+	if got := ClaudeDir(home); got != config {
+		t.Fatalf("ClaudeDir(%q) = %q, want CLAUDE_CONFIG_DIR %q", home, got, config)
+	}
+}
+
+func TestClaudeDirIsHomeDotClaudeWithoutAnAbsoluteClaudeConfigDir(t *testing.T) {
+	home := t.TempDir()
+	for _, value := range []string{"", "relative/config"} {
+		t.Setenv("CLAUDE_CONFIG_DIR", value)
+		if got, want := ClaudeDir(home), filepath.Join(home, ".claude"); got != want {
+			t.Fatalf("CLAUDE_CONFIG_DIR=%q: ClaudeDir(%q) = %q, want %q", value, home, got, want)
+		}
+	}
+}
+
