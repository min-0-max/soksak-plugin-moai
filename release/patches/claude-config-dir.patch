--- a/internal/paths/paths.go
+++ b/internal/paths/paths.go
@@ -57,6 +57,17 @@ func Home() (string, error) {
 	return os.UserHomeDir()
 }
 
+// ClaudeDir returns the configuration home of Claude Code for the home folder
+// home: CLAUDE_CONFIG_DIR when it holds an absolute path, because Claude Code
+// keeps its settings, projects, teams and tasks there, else home joined with
+// .claude.
+func ClaudeDir(home string) string {
+	if v := os.Getenv("CLAUDE_CONFIG_DIR"); v != "" && filepath.IsAbs(v) {
+		return v
+	}
+	return filepath.Join(home, ".claude")
+}
+
